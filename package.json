{
  "name": "medley",
  "private": true,
  "license": "CC-BY-NC-SA-4.0",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "serve": "node server/serve.ts",
    "worker": "node server/worker.ts",
    "refresh": "node scripts/refresh.mjs",
    "start": "vite build && node server/serve.ts",
    "catalog": "node scripts/build-catalog.mjs",
    "typecheck": "tsc --noEmit",
    "import-all": "tsx scripts/import-headless.ts --starter",
    "eval:imports": "tsx scripts/eval-imports.ts",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/youtube": "^0.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
