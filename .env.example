# Copy to .env.local (gitignored), or, when hosting, to medley.env in Medley's config folder.
# Everything here is optional; `npm run dev` needs none of it.

# Your contact (email or URL), added to the User-Agent of catalog builds so Wikidata/Wikipedia can
# reach you if a build misbehaves. Unset: requests carry no contact.
# MEDLEY_CONTACT=you@example.com

# --- Hosting (npm run serve / worker; see docs/hosting.md) ---
# Sign-in: put invites in <config dir>/invites.json (see config/invites.example.json), and/or:
# MEDLEY_PASSWORD=a-shared-invite-code
# MEDLEY_SECRET=long-random-string-for-signing-session-cookies
# MEDLEY_ROLE=web            # leave refreshes to `npm run worker` or a cron job
# MEDLEY_TRUST_PROXY=1       # behind Caddy/nginx/a platform proxy
# MEDLEY_RATE_LIMIT=600
# MEDLEY_DATA_DIR=/var/lib/medley
