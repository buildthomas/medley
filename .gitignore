# Dependencies & build output
node_modules/
dist/

# Runtime data and personal config now live outside the repo (scripts/paths.mjs); these
# entries are a safety net for older checkouts and scratch files.
/data/

# Personal config: copy config/my-games.example.json to config/my-games.json
config/*
!config/*.example.json

# Secrets (see .env.example)
.env
.env.*
!.env.example

# User data: library backups, Steam exports
vgm-library*.json
medley-library*.json
steam-library.*
*-backup*.json

# Local tooling
.claude/
.vscode/
*.log
